# Copy to .env and fill in. Never commit .env.

# Postgres. Local dev: postgresql:///evidex
# Supabase: Dashboard > Project "evidex" > Connect > Session pooler URI (contains your DB password)
DATABASE_URL=postgresql:///evidex
TEST_DATABASE_URL=postgresql:///evidex_test

# Code evaluators type to open the app (leave empty to disable the gate)
ACCESS_CODE=

# Local LLM via Ollama (runs natively on the Mac for GPU speed)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b

# Optional literature APIs (later)
NCBI_API_KEY=
NCBI_EMAIL=
