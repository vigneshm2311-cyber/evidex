# Copy to .env and fill in. Never commit .env.

# Postgres. Local dev: postgresql:///evidex
# Supabase: Dashboard > Project "evidex" > Connect > Session pooler URI (contains your DB password)
DATABASE_URL=postgresql:///evidex
TEST_DATABASE_URL=postgresql:///evidex_test

# Evaluator code (everything except editing the spine) and doctor code (can edit the spine).
# Leave both empty for local use without a gate.
ACCESS_CODE=
DOCTOR_CODE=
RUNS_PER_HOUR=10

# Local LLM via Ollama (runs natively on the Mac for GPU speed)
# Model: ollama (local, default) or groq (hosted, for Streamlit Cloud)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# qwen3:8b for Ollama; qwen/qwen3.8-27b for Groq (default when LLM_PROVIDER=groq and this is empty)
LLM_MODEL=qwen3:8b
GROQ_API_KEY=

# Optional literature APIs (later)
NCBI_API_KEY=
NCBI_EMAIL=

# Public link via ngrok (scripts/serve.sh)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Signs the evaluator session token kept in the URL (any long random string)
SESSION_SECRET=
